# Local-development template. Copy to backend/.env.local; never commit that file.
# Production values belong in AWS Secrets Manager or the deployment platform's secret store.

# ---------------------------------------------------------------------------
# Runtime and local services
# ---------------------------------------------------------------------------
ENVIRONMENT=local
API_HOST=0.0.0.0
API_PORT=8000
STOREFRONT_BASE_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3003
DATABASE_URL=postgresql+asyncpg://ponyo:ponyo@localhost:5433/ponyo
REDIS_URL=redis://localhost:6379/0

# Production Supabase PostgreSQL: use a TLS-enabled SQLAlchemy URL.
# On IPv4-only AWS hosts, use Supabase's session pooler (not transaction mode):
# postgresql+asyncpg://postgres.<project-ref>:<url-encoded-password>@<session-pooler-host>:5432/postgres?ssl=require
# Run and verify migrations against staging before production.
# SQLAlchemy connection-pool limits are currently configured in backend/app/db.py.

# ---------------------------------------------------------------------------
# Public domain, sessions, and local admin seed
# ---------------------------------------------------------------------------
# Production example: https://byponyo.com; use the exact same origin in FRONTEND_ORIGINS.
# For staging, use the staging storefront origin and a separate database/secrets.
JWT_SECRET=replace-with-a-random-32-byte-secret
JWT_ISSUER=ponyo-api
SESSION_COOKIE_NAME=ponyo_session
CSRF_COOKIE_NAME=ponyo_csrf
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Local/demo seed only. Production seeding is disabled.
INITIAL_ADMIN_EMAIL=hello@byponyo.com
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FIRST_NAME=Admin

# ---------------------------------------------------------------------------
# Stripe checkout
# ---------------------------------------------------------------------------
# Use Stripe test credentials in staging. Configure live keys only after launch approval.
# ENVIRONMENT=production requires both Stripe keys, even before checkout is enabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CAPTURE_METHOD=automatic
STRIPE_SUCCESS_URL=http://localhost:3000/orders?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/checkout?checkout=cancelled
CHECKOUT_STANDARD_SHIPPING_JPY=0
CHECKOUT_EXPRESS_SHIPPING_JPY=1200
# Merchant-reviewed exclusive tax rates in basis points; {} means no tax collected.
CHECKOUT_TAX_RATES_BPS={}
CHECKOUT_TAX_SHIPPING=false

# ---------------------------------------------------------------------------
# AWS services and supplier integrations
# ---------------------------------------------------------------------------
AWS_REGION=ap-northeast-1
# Required in production for publishing transactional outbox events.
SQS_ORDER_EVENTS_URL=
EVENTBRIDGE_BUS_NAME=
# Reserved for future S3-backed app features; current maker/product photo uploads use Supabase Storage.
S3_BUCKET=
SUPPLIER_FORWARDING_ENABLED=false
# Trusted HTTPS integration map by supplier code; store real tokens only in a secret manager.
SUPPLIER_INTEGRATIONS={}
SUPPLIER_MAX_ATTEMPTS=5
SUPPLIER_RETRY_BASE_SECONDS=60
SUPPLIER_CONFIRMATION_TIMEOUT_SECONDS=86400

# ---------------------------------------------------------------------------
# Translation
# ---------------------------------------------------------------------------
# Keep the production translation service private; do not expose it directly to the internet.
TRANSLATION_PROVIDER=libretranslate
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=
TRANSLATION_TIMEOUT_SECONDS=8

# ---------------------------------------------------------------------------
# Supabase Storage
# ---------------------------------------------------------------------------
# The backend-only service-role key bypasses Storage access policies. Never expose it
# through NEXT_PUBLIC_* or send it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket for maker application photos and admin previews.
SUPABASE_MAKER_APPLICATIONS_BUCKET=maker-application-photos
# Public bucket for approved product photos displayed on the storefront.
SUPABASE_PRODUCT_IMAGES_BUCKET=ponyo-product-images

# ---------------------------------------------------------------------------
# Hostinger transactional email
# ---------------------------------------------------------------------------
# SMTP submission uses STARTTLS. Verify sender-domain SPF, DKIM, and DMARC before launch.
CONTACT_NOTIFICATION_EMAIL=hello@byponyo.com
SUPPORT_NOTIFICATION_EMAIL=support@byponyo.com
PARTNERS_NOTIFICATION_EMAIL=partners@byponyo.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USERNAME=hello@byponyo.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=hello@byponyo.com
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=8

# ---------------------------------------------------------------------------
# Optional legacy single-mailbox inbox settings
# ---------------------------------------------------------------------------
# Prefer the per-mailbox settings below when syncing hello/support/partners in Admin.
EMAIL_INBOX_IMAP_HOST=
EMAIL_INBOX_IMAP_PORT=993
EMAIL_INBOX_IMAP_USERNAME=
EMAIL_INBOX_IMAP_PASSWORD=
EMAIL_INBOX_IMAP_MAILBOX=INBOX
EMAIL_INBOX_IMAP_SSL=true
EMAIL_INBOX_SYNC_INTERVAL_SECONDS=60
EMAIL_INBOX_INITIAL_SYNC_LIMIT=500

# ---------------------------------------------------------------------------
# Admin inbox mailboxes
# ---------------------------------------------------------------------------
# Each mailbox uses its Hostinger email/password for both IMAP and SMTP.
# Keep passwords in backend/.env.local locally or in the production secret store.
EMAIL_INBOX_MAILBOXES__HELLO__ADDRESS=hello@byponyo.com
EMAIL_INBOX_MAILBOXES__HELLO__USERNAME=hello@byponyo.com
EMAIL_INBOX_MAILBOXES__HELLO__PASSWORD=
EMAIL_INBOX_MAILBOXES__HELLO__IMAP_HOST=imap.hostinger.com
EMAIL_INBOX_MAILBOXES__HELLO__IMAP_PORT=993
EMAIL_INBOX_MAILBOXES__HELLO__IMAP_MAILBOX=INBOX
EMAIL_INBOX_MAILBOXES__HELLO__IMAP_SSL=true
EMAIL_INBOX_MAILBOXES__HELLO__SMTP_HOST=smtp.hostinger.com
EMAIL_INBOX_MAILBOXES__HELLO__SMTP_PORT=587
EMAIL_INBOX_MAILBOXES__HELLO__SMTP_STARTTLS=true
EMAIL_INBOX_MAILBOXES__HELLO__FROM_EMAIL=hello@byponyo.com

EMAIL_INBOX_MAILBOXES__SUPPORT__ADDRESS=support@byponyo.com
EMAIL_INBOX_MAILBOXES__SUPPORT__USERNAME=support@byponyo.com
EMAIL_INBOX_MAILBOXES__SUPPORT__PASSWORD=
EMAIL_INBOX_MAILBOXES__SUPPORT__IMAP_HOST=imap.hostinger.com
EMAIL_INBOX_MAILBOXES__SUPPORT__IMAP_PORT=993
EMAIL_INBOX_MAILBOXES__SUPPORT__IMAP_MAILBOX=INBOX
EMAIL_INBOX_MAILBOXES__SUPPORT__IMAP_SSL=true
EMAIL_INBOX_MAILBOXES__SUPPORT__SMTP_HOST=smtp.hostinger.com
EMAIL_INBOX_MAILBOXES__SUPPORT__SMTP_PORT=587
EMAIL_INBOX_MAILBOXES__SUPPORT__SMTP_STARTTLS=true
EMAIL_INBOX_MAILBOXES__SUPPORT__FROM_EMAIL=support@byponyo.com

EMAIL_INBOX_MAILBOXES__PARTNERS__ADDRESS=partners@byponyo.com
EMAIL_INBOX_MAILBOXES__PARTNERS__USERNAME=partners@byponyo.com
EMAIL_INBOX_MAILBOXES__PARTNERS__PASSWORD=
EMAIL_INBOX_MAILBOXES__PARTNERS__IMAP_HOST=imap.hostinger.com
EMAIL_INBOX_MAILBOXES__PARTNERS__IMAP_PORT=993
EMAIL_INBOX_MAILBOXES__PARTNERS__IMAP_MAILBOX=INBOX
EMAIL_INBOX_MAILBOXES__PARTNERS__IMAP_SSL=true
EMAIL_INBOX_MAILBOXES__PARTNERS__SMTP_HOST=smtp.hostinger.com
EMAIL_INBOX_MAILBOXES__PARTNERS__SMTP_PORT=587
EMAIL_INBOX_MAILBOXES__PARTNERS__SMTP_STARTTLS=true
EMAIL_INBOX_MAILBOXES__PARTNERS__FROM_EMAIL=partners@byponyo.com
