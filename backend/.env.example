EMAIL_INBOX_MAILBOXES__PARTNERS__SMTP_HOST=smtp.hostinger.com
EMAIL_INBOX_MAILBOXES__PARTNERS__SMTP_PORT=587
EMAIL_INBOX_MAILBOXES__PARTNERS__SMTP_STARTTLS=true
EMAIL_INBOX_MAILBOXES__PARTNERS__FROM_EMAIL=partners@byponyo.com
